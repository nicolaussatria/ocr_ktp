# Local-only development can leave this blank. Set a random key on a server.
OCR_API_KEY=
# UI password defaults to OCR_API_KEY when blank. Username defaults to learner.
OCR_UI_USERNAME=learner
OCR_UI_PASSWORD=
OCR_CPU_THREADS=2
OCR_FIELD_THRESHOLD=0.93
OCR_NIK_THRESHOLD=0.98
# KTP only: single-read threshold. Business accurate mode always requires two reads.
OCR_SINGLE_PASS_THRESHOLD=0.99
# true = a NIK is only accepted when birth date and gender are accepted outright.
OCR_STRICT_NIK_CROSS_CHECK=false
# Recover dropped word breaks from the image. Adds roughly 15-20% to a scan.
OCR_RESPACE_WORDS=true
# Accept a printed gender that agrees with an already accepted NIK's encoding.
OCR_NIK_CORROBORATES_GENDER=true
OCR_MAX_UPLOAD_MB=10
OCR_MAX_PIXELS=20000000
OCR_MAX_SIDE=2000
OCR_QUEUE_TIMEOUT_SECONDS=3
OCR_DEFAULT_PHONE_REGION=ID
# Accurate OCR for both card types: retry a magnified text crop when the median
# detected text height is small. The KTP/business split matters only for latency.
OCR_SMALL_TEXT_RETRY=true
# Accurate KTP: retry the identity/address block when key fields still need review.
# Adds at most two OCR passes; false disables this independently of small-text retries.
OCR_KTP_RECOVERY=true
# Median glyph height in processed pixels below which the retry runs (16-64).
OCR_SMALL_TEXT_HEIGHT_PX=28
# Tilted photographs: accurate mode re-reads a levelled view when the detected text
# lines are tilted by more than about a degree (one extra read, only on those photos);
# fast mode levels the geometry of its single read instead.
OCR_DESKEW_RETRY=true
# Both modes: when a card is photographed on a background, read a flattened,
# full-resolution view of the card. Falls back to the whole photo (one extra read)
# when that view does not read as the requested card. Scans are unaffected.
# Business cards are also found around their own print: held in a hand, lying among
# other cards, in front of a keyboard or a screen. Accurate mode reads the flattened
# card once more; fast mode keeps its one read and drops what is not on the card.
OCR_CARD_DETECTION=true
# Business cards: "(021) 5551234, 5551235" prints the area code once. true completes the
# second landline number with it; false keeps the short number as a review candidate.
OCR_SHARED_AREA_CODE=true
# Retained name from the business-card release: false disables the small-print retry.
OCR_BUSINESS_RETRY=true
# JSON array; required only for direct cross-origin web clients.
OCR_CORS_ORIGINS=[]
