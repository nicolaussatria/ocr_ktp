            "title": "File",
            "description": "One JPEG, PNG, or WebP image"
          },
          "mode": {
            "type": "string",
            "enum": [
              "fast",
              "accurate"
            ],
            "title": "Mode",
            "default": "accurate"
          },
          "include_raw": {
            "type": "boolean",
            "title": "Include Raw",
            "default": false
          },
          "rotation": {
            "type": "integer",
            "title": "Rotation",
            "default": 0
          },
          "phone_region": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone Region",
            "description": "Phone country for national numbers, e.g. ID or US"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_recognize_v1_ocr__document_type__post"
